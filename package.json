{
  "name": "cc-web",
  "version": "0.1.0",
  "private": true,
  "description": "Personal single-user web console for Claude Code (claude -p), with an isolated hot-reloading apps host.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start:core": "node packages/core/src/server.js",
    "start:apps": "node packages/apps/src/server.js",
    "dev": "node scripts/dev.js",
    "hash-pass": "node scripts/hash-pass.js"
  },
  "dependencies": {
    "bcrypt": "6.0.0"
  }
}
