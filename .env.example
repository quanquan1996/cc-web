# ---------------------------------------------------------------------------
# CC-Web configuration. Copy to .env for local dev (cp .env.example .env).
# In production these live in /etc/cc-web/env (written by deploy/install.sh,
# chmod 600) and are loaded by systemd via EnvironmentFile=.
# Values are taken literally: no $VAR expansion. Wrap values containing '#'
# or spaces in single quotes. NEVER commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

# --- Network ---------------------------------------------------------------
# Port of the core console (listens on 0.0.0.0). This is the CloudFront origin port.
PORT_CORE=8787
# Port of the isolated apps service (listens on 127.0.0.1 only, never exposed).
PORT_APPS=8788
# Where core reverse-proxies /apps/* to. Keep it on loopback.
APPS_SERVICE_URL=http://127.0.0.1:8788

# --- Authentication (single admin account, no registration) ---------------
# Login user name.
ADMIN_USER=qpj
# bcrypt hash of the admin password. Generate with:  npm run hash-pass -- 'your-password'
# Paste it in single quotes, e.g. ADMIN_PASS_HASH='$2b$12$....'
# Empty = login disabled (the server still boots, /api/login returns 503).
ADMIN_PASS_HASH=
# HMAC secret used to sign session JWTs. Use >= 32 random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Empty = a random secret is generated at boot (all sessions die on restart).
JWT_SECRET=
# Session (JWT cookie) lifetime in hours.
SESSION_TTL_HOURS=12
# Set to false ONLY for plain-http testing in browsers that refuse Secure
# cookies on http://localhost (e.g. Safari). Must be true in production.
COOKIE_SECURE=true

# --- Login brute-force protection -----------------------------------------
# Exponential lockout per client IP: the n-th consecutive failed login locks
# the IP for 3^(n-1) seconds (1, 3, 9, 27, …), capped at LOGIN_LOCK_MAX_SEC.
LOGIN_LOCK_MAX_SEC=3600
# Forget an IP's failure count after this many minutes without failures.
LOGIN_LOCK_RESET_MIN=1440
# true = derive the client IP from the right-most X-Forwarded-For entry
# (the address CloudFront saw). Set false if the server is reached directly.
TRUST_PROXY=true

# --- Origin protection -----------------------------------------------------
# Shared secret that CloudFront injects as the "X-Origin-Secret" origin custom
# header. When set, every request (except GET /healthz) without the matching
# header gets 403. Leave empty for local dev; ALWAYS set in production.
ORIGIN_SECRET=

# --- Claude Code runner ----------------------------------------------------
# Comma-separated list of directories Claude Code may run in (cwd whitelist).
# Every cwd is resolved with realpath and must stay inside one of these.
# Empty = ./workspace inside the repo (dev default, created automatically).
ALLOWED_ROOTS=/home/ec2-user/projects
# claude executable (name on PATH or absolute path, e.g. /home/ccweb/.local/bin/claude).
CLAUDE_BIN=claude
# Extra flags appended to every claude invocation (space separated).
# In -p mode Claude cannot ask for permission, so without something like
# "--permission-mode acceptEdits" it will refuse to edit files.
CLAUDE_EXTRA_ARGS=--permission-mode acceptEdits
# Max number of concurrent claude processes across all clients.
MAX_CONCURRENT_RUNS=2

# --- Apps ------------------------------------------------------------------
# Directory holding generated apps (apps/<name>/). Relative paths are resolved
# against the repository root. Must be writable by both services.
APPS_DIR=./apps
# Allow "dynamic" apps (CC-generated Node servers run as child processes).
# DANGEROUS: this executes arbitrary generated code. Keep false unless you
# understand the risk (see README "Security warning").
APPS_DYNAMIC_ENABLED=false
# true = core adds "Content-Security-Policy: sandbox ..." to every /apps/*
# response so app pages run in an opaque origin and cannot call /api/* with
# your session cookie. Disabling it lets any generated app act as you.
APPS_SANDBOX=true

# --- Storage / logging -----------------------------------------------------
# Runtime data (sessions.json, audit.log). Relative to the repository root.
DATA_DIR=./data
# Fastify log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
